{
  "name": "openchallenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node build",
    "local": "tsx scripts/local.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "content:check": "tsx scripts/check-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:provision": "tsx scripts/provision-db.ts",
    "db:encrypt-tokens": "tsx scripts/encrypt-oauth-tokens.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "npm run test:integration",
    "test:security": "svelte-kit sync && tsx --test tests/security.test.ts tests/uploads.test.ts",
    "test:integration": "svelte-kit sync && tsx scripts/integration.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@lucide/svelte": "^1.62.0",
    "better-auth": "^1.7.14",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.2",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "license": "EUPL-1.2"
}
