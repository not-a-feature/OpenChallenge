DATABASE_URL=postgresql://portal:local-development-only@127.0.0.1:5432/portal
POSTGRES_PASSWORD=local-development-only
WEB_DATABASE_PASSWORD=local-web-password-replace-before-deployment
WORKER_DATABASE_PASSWORD=local-worker-password-replace-before-deployment
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Use the same origin for the web build and runtime; rebuild after changing it.
ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional OIDC provider or approved Shibboleth-to-OIDC bridge; configure all three.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_LOGIN_LABEL=Organization sign-in
DEMO_MODE=true
UPLOAD_DIR=./data/uploads
GROUND_TRUTH_DIR=./examples/example/private
POLL_SECONDS=2
JOB_TIMEOUT_SECONDS=120
ADMIN_EMAILS=demo@example.test
PUBLIC_DOMAIN=localhost
