DATABASE_URL=postgresql://portal:local-development-only@127.0.0.1:5432/portal
POSTGRES_PASSWORD=local-development-only
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Use the same origin for the web build and runtime; rebuild after changing it.
ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional OIDC provider or approved Shibboleth-to-OIDC bridge; configure all three.
UNIVERSITY_OIDC_CLIENT_ID=
UNIVERSITY_OIDC_CLIENT_SECRET=
UNIVERSITY_OIDC_DISCOVERY_URL=
UNIVERSITY_LOGIN_LABEL=University sign-in
DEMO_MODE=true
UPLOAD_DIR=./data/uploads
GROUND_TRUTH_DIR=./examples/dna-inversion/private
POLL_SECONDS=2
JOB_TIMEOUT_SECONDS=120
ADMIN_EMAILS=demo@example.test
PUBLIC_DOMAIN=localhost
